# Lighting Core Environment Configuration
# Copy this file to .env and update with your actual values

# Application Environment
ENVIRONMENT=development
DEBUG=true

# Server Configuration
HOST=0.0.0.0
PORT=3000
SECRET_KEY=your-secret-key-here

# Bitcoin Configuration
BITCOIN_NETWORK=testnet
BITCOIN_NODE_URL=http://localhost:18332
BITCOIN_RPC_USER=bitcoin
BITCOIN_RPC_PASSWORD=password

# Lightning Network Configuration
LN_NODE_URL=http://localhost:8080
LN_GRPC_PORT=10009
LN_REST_PORT=8080

# Wallet Configuration
WALLET_TYPE=hd_wallet
WALLET_PATH=./wallets
MAX_ADDRESSES_PER_WALLET=1000

# Fee Configuration (satoshis per byte)
FEE_LOW=1
FEE_MEDIUM=5
FEE_HIGH=10
FEE_ACCELERATE=15

# Transaction Configuration
MIN_CONFIRMATIONS=6
STUCK_TX_THRESHOLD_HOURS=2

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/lighting_core

# API Configuration
API_RATE_LIMIT=100
API_RATE_LIMIT_WINDOW=60
CORS_ORIGINS=http://localhost:3000,http://localhost:5000

# Security Configuration
REQUIRE_HTTPS=false
SECURE_COOKIES=false
CSRF_PROTECTION=true

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/lighting_core.log

# Cache Configuration
CACHE_TYPE=redis
CACHE_DEFAULT_TIMEOUT=300

# External APIs
BLOCKCHAIN_API_KEY=your-api-key-here
BLOCKCHAIN_API_URL=https://api.blockchain.com/v3

# Feature Flags
ENABLE_RBAC=true
ENABLE_2FA=true
ENABLE_HARDWARE_WALLET=false
ENABLE_MULTI_SIG=true

# Node.js Specific
NODE_ENV=development
